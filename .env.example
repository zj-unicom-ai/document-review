# Application
APP_ENV=development
APP_NAME=document-review
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database. Set DATABASE_URL for SQLite or another explicit URL; otherwise build from DB_*.
DATABASE_URL=sqlite+aiosqlite:///./local.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=docrev
DB_PASSWORD=
DB_NAME=document_review
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 默认导入通用平台元数据；业务规则包不由公开部署默认导入。
SEED_STANDARD_RULES=false

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LLM_MAX_CONCURRENCY=4

# LLM (ChatOpenAI compatible endpoints)
# 档位专用配置优先；未配置的 base URL / API key / model 回退到下方共享网关。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEXT_BASE_URL=https://api.openai.com/v1
LLM_TEXT_API_KEY=sk-placeholder
LLM_TEXT_MODEL=gpt-4o-mini
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_API_KEY=sk-placeholder
LLM_VISION_MODEL=gpt-4o
LLM_LIGHT_BASE_URL=https://api.openai.com/v1
LLM_LIGHT_API_KEY=sk-placeholder
LLM_LIGHT_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_S=60

# MinIO
MINIO_UPLOAD_URL=http://127.0.0.1:9093
MINIO_ACCESS_KEY=placeholder
MINIO_SECRET_KEY=placeholder
MINIO_PUBLIC_POLICY_BUCKET=placeholder
MINIO_ENDPOINT=http://127.0.0.1:9093

# Auth. Generate AUTH_SECRET_KEY with `openssl rand -base64 48`.
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=43200
# Docker bootstrap 默认使用该固定初始密码；本地 CLI 需在命令前显式导出。
SUPERADMIN_INITIAL_PASSWORD=Changeme@2026

# Storage
STORAGE_ROOT=./storage

# External services (point to real ones in prod)
# MinerU：self_host 使用 MINERU_PRIVATE_API_SERVER；cloud_zip 使用 MINERU_API_BASE/TOKEN
MINERU_PROVIDER=self_host
MINERU_API_BASE=
MINERU_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_MAX_POLLS=120
MINERU_TIMEOUT_SECONDS=120
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_PRIVATE_API_SERVER=
MINERU_PRIVATE_BACKEND=hybrid-auto-engine
# MINERU_BASE_URL=
ELASTICSEARCH_URL=
LANGFUSE_BASE_URL=

# 调用方规则驱动的无状态入口
AGENT_API_KEY=
AGENT_TIMEOUT_S=600
AGENT_MAX_PAGES=100
AGENT_MAX_UPLOAD_MB=50

# 以上配置供独立平台读取；核心 document-review-core 不自动读取环境。
# 嵌入宿主应显式注入模型与预算。
