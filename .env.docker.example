# 通用 Docker Compose 配置模板。复制为 .env.docker 后填写真实值；不要提交真实密钥。
COMPOSE_PROJECT_NAME=document-review

# 宿主机访问端口
API_PORT=8000
WEB_PORT=8080

# MySQL：首次启动会创建数据库；密码必须显式提供。
MYSQL_ROOT_PASSWORD=change-me-database-password
MYSQL_DATABASE=document_review
MYSQL_USER=document_review
MYSQL_PASSWORD=change-me-database-password
MYSQL_BIND_HOST=127.0.0.1
MYSQL_PORT=3306
# 推荐运行 setup_docker.py 生成随机值；手工复制时必须替换。
AUTH_SECRET_KEY=change-me-auth-secret-key
AUTH_SESSION_TTL_SECONDS=43200
# 首次启动激活 superadmin/admin；已修改密码后重启不会覆盖。
SUPERADMIN_INITIAL_PASSWORD=Changeme@2026
BOOTSTRAP_SUPERADMIN=true

# 后端数据库配置由 Compose 注入到 DB_*。
DB_HOST=mysql
DB_PORT=3306
DB_USER=document_review
DB_NAME=document_review

# 应用运行配置。
APP_ENV=production
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_LOG_LEVEL=INFO
RUN_PLATFORM_SEED=true
# 通用镜像禁止业务规则包；该值必须保持 false。
SEED_STANDARD_RULES=false
STORAGE_ROOT=/app/storage

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 外部能力：默认留空，平台可启动；解析 / LLM 相关请求会明确提示未配置。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_LIGHT_MODEL=
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_CONCURRENCY=4
LLM_PROFILE_DISCOVERY=true

# MinerU：留空时解析能力未配置；使用 --profile mocks 时可指向内置 mock。
# MINERU_PRIVATE_API_SERVER=http://mock-mineru:8000/file_parse
MINERU_PRIVATE_API_SERVER=
MINERU_PRIVATE_BACKEND=hybrid-auto-engine
MINERU_TIMEOUT_SECONDS=120

# 可选对象存储；不配置时本地 storage volume 是默认路径。
MINIO_UPLOAD_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_POLICY_BUCKET=
MINIO_ENDPOINT=
